<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>HUGS VIP Card</title><link rel="stylesheet" href="/styles.css"/></head><body><div class="gold-particles"></div><div class="blue-hearts-container" id="blueHearts"></div><header class="site-header"><div class="wrap header-inner"><a href="/" class="logo-link" aria-label="Return to HUGS home">
      <img src="/assets/hugs-house-logo.png" alt="HUGS Home" class="site-logo" />
    </a><nav class="nav"><a href="/" class="nav-link">Home</a><a href="/shop.html" class="nav-link">Shop</a><a href="/send-a-hug.html" class="nav-link">Send a Hug</a><a href="/resources.html" class="nav-link">Resources</a>
      <a href="/request-help.html" class="nav-link">Request Help</a><a href="/books.html" class="nav-link">Books</a><a href="/vip-counter.html" class="nav-link">VIP Counter</a></nav></div></header><main class="wrap"><section class="hero"><h1>HUGS VIP Member Card</h1><p class="muted">First 333 supporters who complete a $10+ purchase unlock a digital VIP card.</p></section><section class="section"><div class="card" style="text-align:center"><h2>Find Your VIP Card</h2><input id="vipEmail" class="vip-input" placeholder="your@email.com"><button class="btn primary" onclick="lookupVIP()">Unlock Card</button></div></section><section id="vipResult"></section></main><script>async function lookupVIP(){const email=document.getElementById('vipEmail').value.trim();if(!email)return alert('Enter your email');const r=await fetch('/.netlify/functions/get-vip-member?email='+encodeURIComponent(email));const d=await r.json();document.getElementById('vipResult').innerHTML=r.ok?`<div class='card' style='text-align:center'><p class='badge'>VIP RECEIPT REWARDS</p><h2>HUGS VIP MEMBER</h2><h1 style='font-size:72px'>#${d.vip_number}</h1><p class='muted'>${d.email}</p></div>`:`<div class='card'><h2>Not Found Yet</h2><p class='muted'>If you just purchased, wait a moment and try again.</p></div>`}const e=new URLSearchParams(location.search).get('email');if(e){document.getElementById('vipEmail').value=e;lookupVIP()}</script><script>
const heartsContainer=document.getElementById("blueHearts");
function createHeart(){if(!heartsContainer)return;const h=document.createElement("div");h.className="blue-heart";h.innerHTML="❤";h.style.left=Math.random()*100+"vw";h.style.fontSize=(10+Math.random()*18)+"px";h.style.animationDuration=(10+Math.random()*12)+"s";h.style.opacity=.4+Math.random()*.4;heartsContainer.appendChild(h);setTimeout(()=>h.remove(),22000)}
setInterval(createHeart,1200);
</script></body></html>
